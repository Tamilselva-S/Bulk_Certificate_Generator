# ── Application ──────────────────────────────────────────────────────────────
APP_TITLE=Bulk Certificate Generator
APP_VERSION=1.0.0

# ── Paths ─────────────────────────────────────────────────────────────────────
# Directory where generated PDFs are saved (relative to project root).
OUTPUT_DIR=generated_certificates

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite URL. Change to a proper DB URL in production.
DATABASE_URL=sqlite:///./certificates.db

# ── Limits ────────────────────────────────────────────────────────────────────
# Maximum number of recipients allowed in a single job request.
MAX_RECIPIENTS_PER_JOB=500
